# ── Baraka Tutors — environment variables ─────────────────────────────
# Copy this file to `.env` for local development, and set the same keys in
# Vercel → Project (barakatutors) → Settings → Environment Variables.
# NEVER commit a filled-in .env file to GitHub.

# Admin passcode for the admin panel. This is the ONLY place the passcode
# lives in production — it is not hard-coded anywhere in the code.
# When this is set, it overrides any passcode saved from the admin panel.
ADMIN_PASSCODE=change-me-to-a-strong-passcode

# Hosted database (Turso / libSQL — SQLite-compatible, works with the
# Drizzle schema in server/src/schema.ts). Create a free database at
# https://turso.tech, then paste its URL and auth token here.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token
# DATABASE_URL=libsql://your-database.turso.io   # fallback alias

# AI assistant for the live chat — Groq (free, no credit card needed).
# Get a key at https://console.groq.com and paste it here.
# Primary model: openai/gpt-oss-120b (best, human-like; free tier
# ~1,000 requests/day). When that limit is hit, the chat automatically
# falls back to openai/gpt-oss-20b, so the chat never stops. Without a key, chat messages are flagged for
# the admin instead of being answered by AI. On the Muse-hosted version
# the AI is built in and no key is needed.
GROQ_API_KEY=
# AI_API_URL=https://api.groq.com/openai/v1/chat/completions
# AI_MODEL=openai/gpt-oss-120b
# AI_FALLBACK_MODEL=openai/gpt-oss-20b
